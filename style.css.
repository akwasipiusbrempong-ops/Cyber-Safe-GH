* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #f4f7fc;
    color: #172554;
    line-height: 1.6;
}

header {
    background: #071a36;
    color: white;
    padding: 20px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
}

header h2 {
    color: #38bdf8;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 15px;
    font-size: 14px;
}

.hero {
    background: linear-gradient(135deg, #071a36, #075985);
    color: white;
    text-align: center;
    padding: 110px 20px;
}

.hero h1 {
    font-size: 38px;
    margin-bottom: 20px;
}

.hero p {
    margin-bottom: 30px;
}

.button {
    background: #38bdf8;
    color: #071a36;
    padding: 13px 25px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: bold;
}

section {
    padding: 65px 7%;
    text-align: center;
}

section h2 {
    margin-bottom: 25px;
}

.cards {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
}

.card {
    background: white;
    padding: 30px 20px;
    border-radius: 12px;
    width: 280px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.07);
}

.card h3 {
    margin-bottom: 12px;
    color: #0369a1;
}

#about {
    background: #e0f2fe;
}

footer {
    background: #071a36;
    color: white;
    text-align: center;
    padding: 25px;
}

@media (max-width: 600px) {
    header {
        flex-direction: column;
        gap: 15px;
    }

    nav a {
        margin: 0 7px;
    }

    .hero h1 {
        font-size: 29px;
    }
}
